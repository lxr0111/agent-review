APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://agent_review:agent_review@localhost:3307/agent_review
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
# GITHUB_APP_CLIENT_ID=Iv1.your-client-id
# GITHUB_PRIVATE_KEY_PATH=secrets/github-app-private-key.pem
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_HTTP_TIMEOUT_SECONDS=15
GITHUB_TOKEN_REFRESH_BUFFER_SECONDS=300
GITHUB_MAX_PULL_REQUEST_FILES=3000
REVIEW_MAX_FILE_CHANGES=2000
REVIEW_MAX_FILE_PATCH_CHARACTERS=100000
REVIEW_MAX_TOTAL_PATCH_CHARACTERS=300000
LLM_PROVIDER=mock
# LLM_MODEL=your-structured-output-capable-model
# OPENAI_API_KEY=replace-with-your-api-key
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
