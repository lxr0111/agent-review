APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://agent_review:agent_review@localhost:3307/agent_review
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
# GITHUB_APP_CLIENT_ID=Iv1.your-client-id
# GITHUB_PRIVATE_KEY_PATH=secrets/github-app-private-key.pem
